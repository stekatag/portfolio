---
import BaseLayout from "../layouts/BaseLayout.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import Icon from "../components/ui/Icon/Icon.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";
import WorkspacePageHeader from "../components/WorkspacePageHeader.astro";
import { destinations } from "../config/site";
---

<BaseLayout
  title="Connect | Stefan Gogov"
  description="Get in touch with Stefan Gogov for product engineering and collaboration."
>
  <main class="workspace-page connect-page">
    <WorkspacePageHeader
      kicker="Connect"
      title="Let’s start a conversation"
      description="For product engineering, collaboration, or a portfolio follow-up, email is the best way to reach me."
    >
      <ActionLink href={destinations.cv.href} external={destinations.cv.external} title={destinations.cv.title}><Icon icon="readCV" size="1.2em" /> {destinations.cv.label}</ActionLink>
    </WorkspacePageHeader>
    <div class="connect-content">
      <Skills />
      <ContactCTA />
    </div>
  </main>
</BaseLayout>
