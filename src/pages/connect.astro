---
import BaseLayout from "../layouts/BaseLayout.astro";
import Link from "../components/ui/link.astro";
import Icon from "../components/ui/Icon/Icon.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Skills from "../components/Skills.astro";
import { cvUrl } from "../data/portfolio";
---

<BaseLayout
  title="Connect | Stefan Gogov"
  description="Get in touch with Stefan Gogov for product engineering and collaboration."
>
  <main class="workspace-page connect-page">
    <header class="workspace-page-header">
      <p class="workspace-kicker">Connect</p>
      <h1>Let’s start a conversation</h1>
      <p>
        For product engineering, collaboration, or a portfolio follow-up, email
        is the best way to reach me.
      </p>
      <Link href={cvUrl} style="rounded" external title="View Stefan's CV"><Icon icon="readCV" size="1.2em" /> View CV</Link>
    </header>
    <div class="connect-content">
      <Skills />
      <ContactCTA />
    </div>
  </main>
</BaseLayout>
