---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/ui/Icon/Icon.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import TextLink from "../components/ui/TextLink.astro";
import { deliveryAreas, experience, profile } from "../data/portfolio";
import { destinations, routes } from "../config/site";

const currentWork = experience[0];
---

<BaseLayout>
  <main class="workspace-page overview-page">
    <header class="overview-hero">
      <div>
        <p class="workspace-kicker">Overview</p>
        <h1>I build and ship products across the stack</h1>
        <p>{profile.overview}</p>
        <nav class="workspace-actions" aria-label="Overview actions">
          <ActionLink href={destinations.cv.href} external={destinations.cv.external} title={destinations.cv.title}><Icon icon="readCV" size="1.2em" /> {destinations.cv.label}</ActionLink>
          <ActionLink href={routes.connect} variant="outline" title={destinations.email.title}><Icon icon="message" size="1.2em" /> {destinations.email.label}</ActionLink>
        </nav>
      </div>
      <img src="/assets/hero-img.webp" alt="Headshot of Stefan Gogov" width="480" height="620" />
    </header>

    <section class="overview-grid" aria-label="Portfolio overview">
      <article class="workspace-panel workspace-panel--featured">
        <div class="workspace-panel__header"><span class="status-dot status-dot--current"></span><p class="workspace-kicker">Work now</p></div>
        <h2>{currentWork.role}</h2>
        <p class="workspace-panel__context">{currentWork.context}</p>
        <p>{currentWork.summary}</p>
        <TextLink href={routes.experience} title="View professional experience">View experience <Icon icon="terminal-window" size="1em" /></TextLink>
      </article>
      <article class="workspace-panel">
        <p class="workspace-kicker">Delivery areas</p>
        <ul class="delivery-list">
          {deliveryAreas.map(({ title, detail }) => <li><strong>{title}</strong><span>{detail}</span></li>)}
        </ul>
      </article>
      <article class="workspace-panel">
        <p class="workspace-kicker">Personal projects</p>
        <h2>Projects and experiments</h2>
        <p>Explore the personal projects that shaped my product and engineering practice before professional experience.</p>
        <TextLink href={routes.projects} title="View personal projects">Browse projects <Icon icon="code" size="1em" /></TextLink>
      </article>
    </section>
  </main>
</BaseLayout>
