---
import ActionLink from "./ui/ActionLink.astro";
import Icon from "./ui/Icon/Icon.astro";
import type { Props as IconProps } from "./ui/Icon/Icon.astro";
import { destinations } from "../config/site";

const iconLinks = [
  { ...destinations.linkedin, icon: "linkedin" },
  { ...destinations.github, icon: "github-logo" },
  { ...destinations.bio, icon: "handwave" },
] satisfies (typeof destinations[keyof typeof destinations] & { icon: IconProps["icon"] })[];
---

<aside>
  <div class="contact-info stack gap-4">
    <h2 class="contact-info__heading">Let’s connect</h2>
    <p class="contact-info__description">
      For an engineering conversation, collaboration, or portfolio follow-up,
      email is the most direct way to reach me.
    </p>
  </div>
  <div>
    <ActionLink class="contact-cta__action" href={destinations.email.href} title={destinations.email.title}>
      {destinations.email.label}
      <Icon icon="message" size="1.2em" />
    </ActionLink>
    <span>OR</span>
    <div class="socials">
      {
        iconLinks.map(({ href, icon, title, external }) => (
          <a
            href={href}
            class="social"
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            title={title}
          >
            <Icon icon={icon} />
          </a>
        ))
      }
    </div>
  </div>
</aside>

<style lang="scss">
  aside {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 3rem;
    border-radius: 1rem;
    border: 1px solid var(--gray-800);
    padding: 3rem 2rem;
    background-color: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
  }

  .contact-info {
    text-align: center;

    &__heading {
      font-size: var(--text-2xl);
    }

    &__description {
      color: var(--gray-300);
    }
  }

  span {
    display: block;
    text-align: center;
    letter-spacing: 0.25em;
    margin: 1rem 0;
    font-size: var(--text-sm);
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    font-size: var(--text-2xl);

    .social {
      display: flex;
      text-decoration: none;
      color: var(--accent-dark);
      transition: color var(--theme-transition);

      &:hover,
      &:focus {
        color: var(--accent-regular);
      }
    }
  }

  :global(.contact-cta__action) {
    display: flex;
    width: fit-content;
    margin: 0 auto;
    padding: 0.56em 2em;
    gap: 0.8em;
    line-height: 1.1;
  }

  @media (min-width: 32em) {
    :global(.contact-cta__action) { font-size: var(--text-lg); }
  }

  @media (min-width: 50em) {
    aside {
      padding: 5.5rem;
      grid-template-columns: 5fr 3fr;
      justify-content: space-between;
    }

    .contact-info {
      text-align: left;
      max-width: 35rem;

      &__heading {
        font-size: var(--text-3xl);
      }
    }

  }
</style>
