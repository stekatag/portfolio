---
import Icon from "./ui/Icon/Icon.astro";
import Link from "./ui/link.astro";
const currentYear = new Date().getFullYear();
---

<footer>
  <p class="copyright">&copy; {currentYear} Stefan Gogov</p>
  <p class="socials">
    <Link
      class="link flex-link"
      href="https://www.linkedin.com/in/stefan-gogov/"
      title="View Stefan's LinkedIn Profile"
      external
    >
      <Icon icon="linkedin" size="1.2em" />
      <span>LinkedIn</span>
    </Link>
    <Link
      class="link flex-link"
      href="https://github.com/stekatag"
      title="View Stefan's GitHub Profile"
      external
    >
      <Icon icon="github-logo" size="1.2em" />
      <span>GitHub</span>
    </Link>
    <Link
      class="link flex-link"
      href="https://codingly.netlify.app/"
      title="View Stefan's Coding Blog"
      external
    >
      <Icon icon="codeblock" size="1.2em" />
      <span>Blog</span>
    </Link>
    <Link
      class="link flex-link"
      href="/bio"
      title="View Stefan's bio page"
    >
      <Icon icon="handwave" size="1.2em" />
      <span>Bio</span>
    </Link>
  </p>
</footer>
<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-top: auto;
    padding: 3rem 2rem 3rem;
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);

    .link {
      color: var(--gray-400);
    }

    .flex-link {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--gray-400);
  }

  @media (min-width: 50em) {
    footer {
      flex-direction: row;
      justify-content: space-between;
      padding: 2.5rem 5rem;
    }

    .socials {
      justify-content: flex-end;
    }
  }
</style>
