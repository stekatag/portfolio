---
import Icon from "./ui/Icon/Icon.astro";
---

<section class="skills" aria-labelledby="work-heading">
  <header class="skills__header">
    <p class="workspace-kicker">What I work on</p>
    <h2 id="work-heading">Practical product delivery</h2>
  </header>
  <div class="skills__grid">
    <article class="stack gap-2">
    <Icon
      icon="terminal-window"
      color="var(--accent-dark)"
      size="2rem"
      gradient
    />
    <h3>End-to-end engineering</h3>
    <p>
      Laravel, Vue.js, and PostgreSQL work that turns product requirements into
      dependable web features.
    </p>
    </article>
    <article class="stack gap-2">
    <Icon icon="layout" color="var(--accent-dark)" size="2rem" gradient />
    <h3>Mobile and cloud delivery</h3>
    <p>
      React Native applications, AWS, Laravel Cloud, and CI/CD that help a
      product reach users reliably.
    </p>
    </article>
    <article class="stack gap-2">
    <Icon
      icon="code"
      color="var(--accent-dark)"
      size="2rem"
      gradient
    />
    <h3>Collaborative delivery</h3>
    <p>
      Clear communication, mentoring, and coding standards that support steady
      engineering work across a team.
    </p>
    </article>
  </div>
</section>

<style>
  .skills {
    display: grid;
    gap: 1.25rem;
  }

  .skills__header h2 {
    margin-top: 0.3rem;
    font-size: clamp(1.6rem, 2.7vw, 2.1rem);
  }

  .skills__grid {
    display: grid;
    gap: 1rem;
  }

  .skills article {
    border: 1px solid var(--gray-800);
    border-radius: 1rem;
    padding: 1.35rem;
    background: color-mix(in srgb, var(--gray-999) 58%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .skills h3 {
    font-size: var(--text-lg);
  }

  .skills p:not(.workspace-kicker) {
    color: var(--gray-300);
    max-width: 35rem;
  }

  @media (min-width: 60em) {
    .skills__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

    .skills article {
      padding: 1.65rem;
    }
  }
</style>
