---
type Props = {
  href: string;
  external?: boolean;
  block?: boolean;
  style?: "primary" | "rounded" | "roundedInverted";
  class?: string;
  [key: string]: any;
};

const {
  href,
  external = false,
  block = false,
  style = "primary",
  class: className = "",
  ...rest
} = Astro.props;

const styles = {
  primary: "primary",
  rounded: "rounded",
  roundedInverted: "rounded inverted",
};
---

<a
  {href}
  target={external ? "_blank" : undefined}
  {...rest}
  class:list={[styles[style], block && "block", className]}
>
  <slot />
</a>

<style lang="scss">
  .primary:link,
  .primary:visited {
    text-decoration: none;
  }

  .block {
    display: block;
    width: 100%;
  }

  .rounded:link,
  .rounded:visited {
    display: flex;
    text-decoration: none;
    padding: 0.5rem 1rem;
    gap: 0.5rem;
    color: var(--accent-text-over);
    border: 1px solid color-mix(in srgb, var(--accent-light) 38%, var(--accent-regular));
    background: linear-gradient(
      115deg,
      color-mix(in srgb, var(--accent-light) 22%, var(--accent-regular)),
      var(--accent-regular) 58%,
      color-mix(in srgb, var(--accent-dark) 20%, var(--accent-regular))
    );
    border-radius: 999rem;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--gray-999) 22%, transparent), 0 0.4rem 1rem color-mix(in srgb, var(--accent-regular) 14%, transparent);
    font-size: var(--text-md);
    line-height: 1.35;
    white-space: nowrap;
    transition: background var(--theme-transition), border-color var(--theme-transition), box-shadow var(--theme-transition), color var(--theme-transition);

    &.inverted {
      background: linear-gradient(115deg, color-mix(in srgb, var(--accent-light) 11%, var(--gray-999)), color-mix(in srgb, var(--accent-regular) 8%, var(--gray-999)));
      border-color: color-mix(in srgb, var(--accent-regular) 78%, var(--accent-dark));
      color: var(--accent-dark);
      box-shadow: inset 0 1px 0 color-mix(in srgb, var(--gray-999) 20%, transparent);
    }

    &:hover,
    &:focus-visible {
      border-color: var(--accent-light);
      background: linear-gradient(115deg, color-mix(in srgb, var(--accent-light) 30%, var(--accent-regular)), var(--accent-regular) 58%, color-mix(in srgb, var(--accent-dark) 24%, var(--accent-regular)));
      box-shadow: inset 0 1px 0 color-mix(in srgb, var(--gray-999) 30%, transparent), 0 0.55rem 1.2rem color-mix(in srgb, var(--accent-regular) 21%, transparent);
      color: var(--accent-text-over);
    }
  }
</style>
